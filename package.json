{
  "name": "node-certkit",
  "version": "1.1.2",
  "description": "Node-only TypeScript PKI and cryptography library for certificate handling (PKCS#12, X.509, RSA).",
  "author": "Alexssmusica",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Alexssmusica/node-certkit.git"
  },
  "bugs": {
    "url": "https://github.com/Alexssmusica/node-certkit/issues"
  },
  "homepage": "https://github.com/Alexssmusica/node-certkit#readme",
  "sideEffects": false,
  "main": "./lib/index.js",
  "types": "./lib/index.d.ts",
  "files": [
    "/lib",
    "package.json",
    "README.md"
  ],
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "clean-lib": "npx rimraf lib && npx rimraf tsconfig.build.tsbuildinfo",
    "build": "npm run clean-lib && tsc -p tsconfig.build.json",
    "build-release": "npm run format && npm run build && node release.js && npm run publish:npm",
    "format": "prettier --write \"**/*.{js,ts,mts,json}\" --ignore-path .gitignore",
    "publish:npm": "node publish.js",
    "release": "node release.js",
    "release:dry": "node version-preview.js",
    "release:dry:full": "node release-dry.js",
    "type": "tsc --project tsconfig.json",
    "dev": "tsc -p tsconfig.build.json --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:types": "tsc -p tsconfig.test.json --noEmit",
    "test:types:public": "tsc -p tsconfig.types.json --noEmit",
    "test:dts": "tsc -p tsconfig.dts.json --noEmit",
    "test:security": "vitest run tests/security",
    "lint": "eslint src/ tests/"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@semantic-release/changelog": "^7.0.0",
    "@semantic-release/commit-analyzer": "^13.0.1",
    "@semantic-release/git": "^11.0.1",
    "@semantic-release/github": "^12.0.10",
    "@semantic-release/npm": "^13.2.0",
    "@semantic-release/release-notes-generator": "^14.1.1",
    "@types/node": "^24.13.3",
    "dotenv": "^18.0.8",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "semantic-release": "^25.0.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  },
  "keywords": [
    "aes",
    "asn.1",
    "asn1",
    "crypto",
    "cryptography",
    "csr",
    "des",
    "hmac",
    "md5",
    "pbkdf2",
    "pem",
    "pkcs8",
    "pkcs12",
    "pki",
    "prng",
    "rc2",
    "rsa",
    "sha1",
    "sha256",
    "sha512",
    "typescript",
    "x.509",
    "x509",
    "certificate",
    "pfx"
  ]
}
